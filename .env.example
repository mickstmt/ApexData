# ---------------------------------------------------------------------------
# Base de datos (Supabase)
# ---------------------------------------------------------------------------
# Runtime: conexión agrupada (pooler). En producción añade ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/apexdata?schema=public"
# Migraciones: conexión directa. El pooler no soporta prepared statements.
DIRECT_URL="postgresql://user:password@localhost:5432/apexdata?schema=public"

# ---------------------------------------------------------------------------
# APIs públicas de F1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_JOLPICA_API_URL="https://api.jolpi.ca/ergast/f1"
NEXT_PUBLIC_OPENF1_API_URL="https://api.openf1.org/v1"

# ---------------------------------------------------------------------------
# Microservicio de telemetría (FastAPI + FastF1)
# ---------------------------------------------------------------------------
# En local: http://localhost:8000 (valor por defecto si se omite).
# En producción: la URL pública del servicio. Si no está definida, la sección
# de telemetría avisa de que no está disponible en lugar de fallar.
# FASTF1_SERVICE_URL="https://telemetria.tu-dominio.com"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Avisos push
# ---------------------------------------------------------------------------
# La clave PRIVADA del par VAPID. La pública no va aquí: viaja al navegador por
# definición y está escrita en `src/lib/push-claves.ts`.
#
# Sin esta variable el reloj de avisos no arranca y lo dice al iniciar. En
# producción va en las variables de EasyPanel, y en GitHub como secreto para la
# red del cron. Se genera con `webpush.generateVAPIDKeys()`.
# VAPID_PRIVATE_KEY=""

# Pon 0 para apagar el reloj de avisos sin tocar código.
# AVISOS_AUTOMATICOS="1"
