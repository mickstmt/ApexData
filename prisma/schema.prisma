// ApexData - Prisma Schema
// Formula 1 Data Platform Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app; serverless opens many short-lived clients.
  url       = env("DATABASE_URL")
  // Direct connection for migrations, which the pooler cannot serve.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

/// Represents a Formula 1 driver
model Driver {
  id              String    @id @default(cuid())
  driverId        String    @unique // Ergast/Jolpica driver ID (e.g., "hamilton")
  // Neither of these is unique in practice: #1 moves to the reigning champion
  // each year, and codes get reused across eras (Michael and Mick Schumacher
  // both raced as "MSC"). driverId is the only stable identity.
  permanentNumber Int? // Racing number for the current season (e.g., 44)
  code            String? // Three-letter code (e.g., "HAM")
  givenName       String // First name
  familyName      String // Last name
  dateOfBirth     DateTime?
  nationality     String
  url             String? // Wikipedia or official URL
  imageUrl        String? // Profile image URL

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  results       Result[]
  qualifyings   Qualifying[]
  sprintResults SprintResult[]
  standings     DriverStanding[]

  @@index([driverId])
  @@index([nationality])
  @@index([permanentNumber])
  @@map("drivers")
}

/// Represents a Formula 1 constructor/team.
/// Named Team rather than Constructor because `prisma.constructor` collides
/// with Object.prototype.constructor, which breaks both the delegate lookup
/// and the generated row type.
model Team {
  id            String  @id @default(cuid())
  constructorId String  @unique // Ergast/Jolpica constructor ID (e.g., "mercedes")
  name          String
  nationality   String
  url           String? // Wikipedia or official URL
  logoUrl       String? // Team logo URL

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  results       Result[]
  qualifyings   Qualifying[]
  sprintResults SprintResult[]
  standings     ConstructorStanding[]

  @@index([constructorId])
  @@index([nationality])
  @@map("constructors")
}

/// Represents a racing circuit
model Circuit {
  id        String  @id @default(cuid())
  circuitId String  @unique // Ergast/Jolpica circuit ID (e.g., "monaco")
  name      String
  location  String // City
  country   String
  lat       Float? // Latitude
  lng       Float? // Longitude
  alt       Int? // Altitude in meters
  url       String? // Wikipedia or official URL
  imageUrl  String? // Circuit layout image URL

  // Circuit details
  length        Float? // Length in km
  corners       Int? // Number of corners
  drsZones      Int? // Number of DRS zones
  lapRecord     String? // Lap record time
  lapRecordYear Int? // Year of lap record

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  races Race[]

  @@index([circuitId])
  @@index([country])
  @@map("circuits")
}

/// Represents a Formula 1 season
model Season {
  id   String  @id @default(cuid())
  year Int     @unique
  url  String? // Wikipedia URL

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  races Race[]

  @@index([year])
  @@map("seasons")
}

/// Represents a race event (Grand Prix)
model Race {
  id       String  @id @default(cuid())
  raceId   String? // Ergast/Jolpica race ID (optional, for legacy data)
  year     Int
  round    Int // Round number in the season
  raceName String // e.g., "Monaco Grand Prix"

  // Dates and times (UTC)
  date       DateTime
  time       String? // Race start time
  fp1Date    DateTime? // Free Practice 1
  fp1Time    String?
  fp2Date    DateTime?
  fp2Time    String?
  fp3Date    DateTime?
  fp3Time    String?
  qualiDate  DateTime? // Qualifying
  qualiTime  String?
  sprintDate DateTime? // Sprint race (if applicable)
  sprintTime String?

  /**
   * La clasificación que ordena la parrilla del sprint, el viernes.
   * Faltaba: un fin de semana al sprint se enseñaba como «Práctica 1 → Sprint»,
   * saltándose la sesión que decide desde dónde sale cada uno. Jolpica la manda
   * como `SprintQualifying` desde que existe el formato.
   */
  sprintQualiDate DateTime?
  sprintQualiTime String?

  url String? // Wikipedia or official URL

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  season    Season  @relation(fields: [year], references: [year], onDelete: Cascade)
  circuit   Circuit @relation(fields: [circuitId], references: [circuitId], onDelete: Restrict)
  circuitId String

  /**
   * Cuándo se avisó de su resultado. Sin esto, un cron que se repita —o que
   * se dispare a mano— mandaría el mismo aviso otra vez.
   */
  notifiedAt DateTime?

  results       Result[]
  qualifyings   Qualifying[]
  sprintResults SprintResult[]

  @@unique([year, round])
  @@index([year])
  @@index([circuitId])
  @@index([date])
  @@map("races")
}

// ============================================================================
// RACE RESULTS
// ============================================================================

/// Represents race results
model Result {
  id String @id @default(cuid())

  // Position and points
  position      Int? // Final position (null if DNF/DNS/DSQ)
  positionText  String // "1", "2", "R" (retired), "D" (disqualified), etc.
  positionOrder Int // Order for sorting (includes DNF positions)
  points        Float  @default(0)

  // Grid and laps
  grid Int // Starting grid position
  laps Int // Laps completed

  // Time and status
  time            String? // Race time (for winner) or gap to winner
  milliseconds    BigInt? // Time in milliseconds
  fastestLap      Int? // Fastest lap number
  rank            Int? // Fastest lap rank
  fastestLapTime  String? // Fastest lap time
  fastestLapSpeed String? // Fastest lap speed (km/h)

  statusId Int // Status ID (1 = Finished, etc.)
  status   String // "Finished", "Accident", "Engine", etc.

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  race          Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  raceId        String
  driver        Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId      String
  team          Team   @relation(fields: [constructorId], references: [id], onDelete: Restrict)
  constructorId String

  @@unique([raceId, driverId])
  @@index([raceId])
  @@index([driverId])
  @@index([constructorId])
  @@index([position])
  @@map("results")
}

/// Represents qualifying results
model Qualifying {
  id String @id @default(cuid())

  position Int
  q1       String? // Q1 time
  q2       String? // Q2 time
  q3       String? // Q3 time

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  race          Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  raceId        String
  driver        Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId      String
  team          Team   @relation(fields: [constructorId], references: [id], onDelete: Restrict)
  constructorId String

  @@unique([raceId, driverId])
  @@index([raceId])
  @@index([driverId])
  @@map("qualifying")
}

/// Represents sprint race results
model SprintResult {
  id String @id @default(cuid())

  position       Int?
  positionText   String
  positionOrder  Int
  points         Float   @default(0)
  grid           Int
  laps           Int
  time           String?
  milliseconds   BigInt?
  fastestLap     Int?
  fastestLapTime String?
  statusId       Int
  status         String

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  race          Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  raceId        String
  driver        Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId      String
  team          Team   @relation(fields: [constructorId], references: [id], onDelete: Restrict)
  constructorId String

  @@unique([raceId, driverId])
  @@index([raceId])
  @@index([driverId])
  @@map("sprint_results")
}

// ============================================================================
// STANDINGS
// ============================================================================

/// Represents constructor championship standings
model ConstructorStanding {
  id String @id @default(cuid())

  year         Int
  round        Int // Round number when this standing was recorded
  position     Int? // null when unclassified (positionText is "-")
  positionText String
  points       Float
  wins         Int    @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  team          Team   @relation(fields: [constructorId], references: [id], onDelete: Restrict)
  constructorId String

  @@unique([year, round, constructorId])
  @@index([year])
  @@index([constructorId])
  @@map("constructor_standings")
}

/// Represents driver championship standings after a given round
model DriverStanding {
  id String @id @default(cuid())

  year         Int
  round        Int // Round number when this standing was recorded
  position     Int? // null when unclassified (positionText is "-")
  positionText String
  points       Float
  wins         Int    @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId String

  @@unique([year, round, driverId])
  @@index([year])
  @@index([driverId])
  @@map("driver_standings")
}

/**
 * Un navegador que quiere enterarse de los resultados.
 * No hay cuentas en ApexData, así que esto es lo más parecido a un usuario: el
 * navegador se suscribe, el servicio de push le da una dirección única y aquí
 * se guarda con sus dos claves. Se borra sola cuando el servicio la rechaza,
 * que es lo que pasa al desinstalar la app o al limpiar el navegador.
 */
model PushSubscription {
  id String @id @default(cuid())

  /**
   * La URL que el navegador da para recibir avisos. Identifica la suscripción.
   */
  endpoint String @unique
  /**
   * Clave pública del navegador, para cifrar el contenido del aviso.
   */
  p256dh   String
  /**
   * Secreto de autenticación del navegador, del mismo protocolo.
   */
  auth     String

  /**
   * Para saber desde qué clase de aparato llegó, sin identificar a nadie.
   */
  userAgent String?

  /**
   * A quién sigue quien recibe estos avisos: `driverId` separados por comas.
   * Los favoritos vivían solo en el `localStorage` del teléfono, y por eso el
   * servidor no podía escribir un aviso que hablara de tu piloto: no sabía
   * cuál era. Se guardan aquí, junto a la suscripción, porque es el aviso —y no
   * la pantalla— quien los necesita.
   * Se guarda el `driverId` y no el código de tres letras porque el código no
   * es estable: se reutiliza entre épocas (Michael y Mick Schumacher fueron
   * los dos «MSC»). La traducción a código se hace al redactar, con la
   * temporada delante.
   * Vacío o nulo es válido: el aviso sale igual, contando lo que pasó.
   */
  favoriteDrivers      String?
  favoriteConstructors String?

  /**
   * De qué sesiones se avisa, por sus códigos separados por comas.
   * Nulo significa todas, que es lo que se pidió: las siete del fin de semana.
   * Existe para poder apagar las prácticas sin renunciar al resto.
   */
  sessions String?

  /**
   * El huso horario de quien recibe los avisos: `America/Lima`.
   * Hace falta para la previa, que no sale «N horas antes» sino a las 20:00 de
   * la noche anterior — y esas 20:00 son las del reloj de esta persona, no las
   * del circuito. Lo manda el navegador solo al activar los avisos; sin él, esa
   * suscripción se queda sin previa pero sigue recibiendo los resultados.
   */
  timezone String?

  previas SentPreview[]

  /**
   * De quien es esta suscripcion, si es que hay alguien detras.
   * Nulo es lo normal y lo seguira siendo: se puede recibir avisos sin cuenta,
   * exactamente como hasta ahora. Se rellena al entrar, y es lo que hace que
   * los avisos dejen de depender del aparato: al entrar en un telefono nuevo,
   * su suscripcion hereda los favoritos de la persona en vez de empezar vacia.
   * `onDelete: SetNull` y no `Cascade`: borrar la cuenta no debe apagarle los
   * avisos a un navegador que sigue suscrito. Se queda como estaba antes de
   * existir las cuentas.
   */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  lastSentAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

/**
 * De qué sesiones ya se avisó.
 * Es lo que hace que el aviso se pueda repetir sin miedo: el disparador corre
 * cada pocos minutos y la mayoría de las veces no hace nada, pero si se reinicia
 * el servidor a mitad, o se despliega, o coinciden dos vueltas, nadie recibe el
 * mismo aviso dos veces.
 * La marca vivía en `races.notifiedAt`, y servía mientras solo se avisaba de la
 * carrera. Con siete sesiones por fin de semana hace falta una marca por sesión,
 * y la clave natural es la que da OpenF1: `session_key` es único y no cambia.
 */
model NotifiedSession {
  /**
   * El `session_key` de OpenF1.
   */
  sessionKey Int @id

  /**
   * Para poder leer la tabla sin cruzarla con nada.
   */
  sessionName String
  year        Int

  /**
   * Cuántas suscripciones recibieron el aviso. Cero también se guarda.
   */
  sent Int @default(0)

  notifiedAt DateTime @default(now())

  @@index([year])
  @@map("notified_sessions")
}

/**
 * El calendario de OpenF1, guardado.
 * OpenF1 es quien sabe QUÉ sesiones existen —con su `session_key`, de la que
 * cuelgan la clasificación, los avisos ya mandados y todo lo demás— y cuándo
 * TERMINAN, que es de donde se cuentan los 35 minutos de espera. Nuestro
 * `Race` guarda los comienzos y ningún final, así que sin esto no se puede
 * saber si una sesión ya acabó sin preguntárselo a OpenF1.
 * Antes se preguntaba en cada vuelta del reloj, y era el PRIMER paso: un fallo
 * suyo mataba la vuelta entera —ni avisos, ni previas—. Con la copia en la
 * base, OpenF1 pasa de dependencia dura a blanda: si no contesta seguimos
 * sabiendo qué sesiones hay y solo perdemos el resultado de la última.
 * La copia en memoria no bastaba: cada despliegue la borra, y la primera
 * vuelta tras arrancar volvía a depender de que OpenF1 contestara.
 * Se siembra de temporada completa en UNA petición —131 sesiones de 2026,
 * 48 KB medidos— porque OpenF1 publica las futuras con su llave y su final
 * desde semanas antes: el 2026-09-25 había 41 futuras hasta Abu Dabi.
 */
model OpenF1Session {
  /// La llave de OpenF1. Es la que usan notified_sessions y sent_previews.
  sessionKey Int @id @map("session_key")

  /// Agrupa las sesiones de un mismo gran premio. No existe en nuestro Race.
  meetingKey Int @map("meeting_key")

  year        Int
  sessionName String @map("session_name")
  sessionType String @map("session_type")

  /// El comienzo, que también tenemos en Race, y el FINAL, que no.
  dateStart DateTime @map("date_start")
  dateEnd   DateTime @map("date_end")

  countryName String @map("country_name")
  location    String

  /// Hoy SIEMPRE llega a false, y conviene saberlo: `sesionesDeTemporada`
  /// descarta las anuladas antes de que lleguen aquí (client.ts), así que la
  /// columna guarda fidelidad con la fuente pero no separa nada por sí sola.
  /// En 2026 se anularon dos grandes premios enteros —Baréin y Arabia Saudí de
  /// abril, diez sesiones—, y por eso se guardan 121 de las 131 que publica
  /// OpenF1. Está aquí para el día que ese filtro se mueva aguas abajo, que es
  /// donde debería estar: quien decide si algo se avisa es el avisador.
  isCancelled Boolean @default(false) @map("is_cancelled")

  /// Cuándo se leyó de OpenF1. De aquí sale si toca refrescar.
  vistaEn DateTime @updatedAt @map("vista_en")

  @@index([year])
  @@index([dateEnd])
  @@map("openf1_sessions")
}

/**
 * La cronometría de una sesión ya corrida, guardada para siempre.
 * Los tiempos de una sesión terminada NO VUELVEN A CAMBIAR, y sin embargo se
 * volvían a pedir una y otra vez: el navegador los guarda cinco minutos y el
 * servicio de telemetría una hora (CACHE_TTL), así que pasada esa hora la
 * primera visita obliga a FastF1 a procesar la sesión entera otra vez.
 * Medido en producción el 2026-09-26: en caliente 0,06 s, en frío 4,35 s. Eso
 * es el «pidiendo los tiempos» que el usuario ve al entrar en una práctica, y
 * lo reportó dos veces —el 15 y el 26—.
 * Ponerle una hora de caducidad a un dato inmutable era el fallo. Aquí no
 * caduca: se guarda cuando la sesión es DEFINITIVA y ya no se vuelve a pedir.
 * Cuesta poco: la pestaña pide la mejor vuelta de cada piloto, 5,5 KB medidos
 * por sesión, unos 700 KB por temporada entera.
 */
model CronometriaDeSesion {
  year Int

  /// La ronda tal y como la pide la ruta, que es texto: «15».
  event String

  /// FP1, FP2, FP3, SQ, S, Q o R.
  sessionType String @map("session_type")

  /// La respuesta entera de /fastest, sin recortar: se sirve recortada al
  /// límite que pida cada quien, así que una sola fila vale para todos.
  datos Json

  /// Cuántas vueltas trae, para poder mirar la tabla sin abrir el JSON.
  vueltas Int

  guardadaEn DateTime @default(now()) @map("guardada_en")

  @@id([year, event, sessionType])
  @@map("cronometria_sesiones")
}

/**
 * Qué previas se han mandado ya, y a quién.
 * Los resultados llevan una marca global —lo que pasó es igual para todos— pero
 * la previa no: sale a las 20:00 de cada cual, así que dos personas en husos
 * distintos la reciben en instantes distintos. Con una marca compartida, la
 * primera en recibirla dejaría a la segunda sin la suya.
 * Se identifica por la primera sesión del día, que es lo que define al grupo.
 */
model SentPreview {
  subscriptionId String
  /**
   * El `session_key` de OpenF1 de la primera sesión de ese día.
   */
  sessionKey     Int

  sentAt DateTime @default(now())

  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, sessionKey])
  @@map("sent_previews")
}

// ============================================================================
// CUENTAS
// ============================================================================

/**
 * Una persona.
 * Hasta ahora ApexData no tenia usuarios: los favoritos vivian en el
 * `localStorage` de cada navegador. Eso significaba tres cosas, y las tres se
 * arreglan aqui: no viajaban entre aparatos —ni siquiera entre la PWA instalada
 * y Safari en el MISMO iPhone, que tienen almacenamientos separados—, se podian
 * perder sin avisar si iOS recuperaba espacio, y los avisos dependian del
 * navegador y no de la persona.
 * La cuenta es OPCIONAL, y eso no es un detalle: sin entrar, la app funciona
 * exactamente igual que antes. Entrar solo añade que tus cosas te sigan.
 * Los cuatro modelos de esta seccion —User, Account, Session y
 * VerificationToken— los exige el adaptador de Prisma de next-auth, y sus
 * nombres de campo no se pueden cambiar: el adaptador los busca asi.
 */
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /**
   * Los favoritos de la persona, con la MISMA forma que en `PushSubscription`:
   * `driverId` separados por comas.
   * Se repite la forma a proposito. Los favoritos ya viajaban al servidor con
   * la suscripcion —para poder redactar un aviso que hable de tu piloto— y
   * copiarlos de un sitio al otro tiene que ser trivial. Se guarda el
   * `driverId` y no el codigo de tres letras por lo mismo que alli: el codigo
   * se reutiliza entre epocas (Michael y Mick Schumacher fueron los dos «MSC»).
   */
  favoriteDrivers      String?
  favoriteConstructors String?

  /**
   * El equipo que tiñe la app, si eligio uno.
   */
  accentTeam String?

  accounts      Account[]
  sessions      Session[]
  suscripciones PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("users")
}

/**
 * La cuenta de un proveedor externo —hoy Google— atada a una persona.
 * Aqui no hay ninguna contraseña, y esa es justo la gracia: ApexData no guarda
 * ninguna, asi que no puede perderla. La recuperacion la hace el proveedor.
 */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/**
 * Una sesion abierta.
 * Existe porque el adaptador la exige, pero **hoy no se usa**: la sesion va en
 * una cookie firmada y no en la base. Con la base en Virginia, guardarla alli
 * costaria una ida y vuelta en cada peticion autenticada solo para saber quien
 * eres, y eso se nota en cada pantalla.
 * El precio de la cookie es que no se puede cerrar la sesion de otro aparato al
 * instante. Si algun dia hace falta, se cambia una linea —`strategy`— y esta
 * tabla empieza a usarse sin migrar nada.
 */
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/**
 * El testigo de un enlace por correo.
 * Todavia no se usa: el correo es el segundo paso, detras de Google. Se crea ya
 * porque el adaptador lo busca —sin esta tabla no compila— y porque añadirla
 * ahora ahorra una segunda migracion cuando llegue.
 */
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
